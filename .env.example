# SACHET AI — .env.example (PLACEHOLDERS ONLY, NO real secrets)
# Copy to .env for local dev. Never commit .env. See docs/CONFIGURATION.md.
# Names map to the Java backend (SACHET_* relaxed binding, see application.yml).

SACHET_APP_ENV=dev
SACHET_CORS_ORIGINS=http://localhost:3000

# --- Data layer (dev defaults; prod via secrets manager) ---
SACHET_DATABASE_URL=jdbc:postgresql://db:5432/sachet
SACHET_DB_USER=sachet
SACHET_DB_PASSWORD=sachet
REDIS_URL=redis://redis:6379/0

# --- Auth (MUST override in any real deployment) ---
# dev-only value (>= 32 chars). The backend refuses dev-only values outside dev.
SACHET_JWT_SECRET=dev-only-local-dev-secret-00000000
SACHET_JWT_EXPIRE_MIN=30

# --- Storage ---
SACHET_STORAGE_PATH=./storage

# --- Ingestion (Phase 3) ---
SACHET_INGESTION_MAX_FILE_BYTES=104857600
# true = uploads REQUIRE a successful malware scan (needs a real scanner bean).
SACHET_REQUIRE_MALWARE_SCAN=false

# --- RAG embeddings (Phase 4: local only, nothing leaves the machine) ---
SACHET_EMBEDDING_MODEL_DIR=./models/paraphrase-multilingual-minilm-l12-v2
SACHET_EMBEDDING_AUTO_DOWNLOAD=true
# jvm (default, tested) or pgvector (EXPERIMENTAL, needs extension + DDL).
SACHET_VECTOR_STORE=jvm

# --- Vector index (pgvector default; Qdrant optional; Phase 4+) ---
VECTOR_STORE=pgvector
EMBEDDING_DIM=768
QDRANT_URL=

# --- Model gateway & Gemini LLM / TTS (gated by ModelPolicy) ---
# When SACHET_SENSITIVE_MODE=false and SACHET_ALLOW_EXTERNAL_MODELS=true,
# external Gemini calls for answers and speech synthesis are authorized.
# Insert your Gemini API key below:
SACHET_GEMINI_API_KEY=
SACHET_GEMINI_MODEL=gemini-1.5-flash
SACHET_GEMINI_TEMPERATURE=0.2
SACHET_GEMINI_MAX_TOKENS=8192

# Speech recognition (STT): "gemini" or "none" (default)
# Uses Gemini multimodal audio transcription for regional Indian languages (Maithili, Punjabi, Hindi, etc.)
SACHET_STT_PROVIDER=none
SACHET_STT_MODEL=gemini-1.5-flash

# Speech synthesis (TTS): "gemini" or "none" (default)
# gemini-3.8-flash-tts natively supports 130+ languages including Maithili, Hindi, Bengali, etc.
SACHET_TTS_PROVIDER=none
SACHET_TTS_MODEL=gemini-3.8-flash-tts

# --- Security / feature flags (secure defaults: external OFF) ---
# Sensitive mode prevents external transfer of document-derived content.
SACHET_SENSITIVE_MODE=true
SACHET_ALLOW_EXTERNAL_MODELS=false

# --- TLS / prod (fill via vault, not git) ---
TLS_ENABLED=false
TLS_CERT_PATH=
TLS_KEY_PATH=
