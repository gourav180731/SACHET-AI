# SACHET AI — .gitignore (security-first)
# Secrets / env
.env
.env.*
!.env.example
*.pem
*.key
secrets/
vault*.json

# Storage / data (never commit user documents or DB dumps)
storage/*
!storage/.gitkeep
backend/storage/
**/storage/*
!**/storage/.gitkeep
*.dump
*.sql.gz
pgdata/
redisdata/

# Local ML models (downloaded once, never committed)
models/

# Java / Maven (server code is Java only)
target/
*.class
*.jar
*.war

# Python (legacy; none in tree anymore)
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
*.egg-info/

# Node / frontend
node_modules/
dist/
.next/
*.local

# OS / IDE
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/

# Logs / tmp
*.log
tmp/
uploads/
test*.txt
backend/test*.txt
structure.txt

