<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <!-- No sensitive content is ever logged by application code (AGENTS.md §13).
       requestId correlates entries with API error envelopes. -->
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level [%X{requestId:-none}] %logger{36} - %msg%n</pattern>
    </encoder>
  </appender>
  <root level="INFO">
    <appender-ref ref="STDOUT"/>
  </root>
</configuration>
